# Backend
PORT=5000
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@cluster.example.mongodb.net/car_care_system?retryWrites=true&w=majority
PROLOG_BASE=http://localhost:8000
# Varias replicas identicas del motor, separadas por comas. Si esta definida,
# manda sobre PROLOG_BASE. El gateway reparte en round-robin, evita una replica
# que falle durante PROLOG_REPLICA_COOLDOWN_MS y devuelve 502 solo si fallan
# todas. Una replica que se pierda alguna mutacion del catalogo se recarga entera
# cuando vuelve. Ej.: http://localhost:8000,http://localhost:8001
PROLOG_BASES=
PROLOG_TIMEOUT_MS=3000
# Timeout de los sondeos de /health de cada replica, y el que confirma su
# identidad antes de repartir. Es el que dispara GET /api/admin/replicas.
PROLOG_HEALTH_TIMEOUT_MS=1000
# Minimo entre sondeos de /health de una misma replica, y validez de una
# confirmacion de identidad: detecta que una replica se reinicio (cambio su
# identificador de arranque) aunque no viera ningun fallo, y recarga la que
# este desactualizada.
PROLOG_RESYNC_MIN_INTERVAL_MS=5000
# Tiempo que se aparta del reparto una replica que acaba de fallar.
PROLOG_REPLICA_COOLDOWN_MS=30000
# Token compartido con el motor: hexadecimal y el mismo valor en los dos. Si el
# motor arranca sin definirlo queda ABIERTO (acepta peticiones sin token) y lo
# avisa por stderr: es lo comodo para un despliegue por etapas, no para
# produccion.
MOTOR_TOKEN=
# Pool HTTP del motor: hilos iniciales (workers) y segundos que un hilo ocioso
# mantiene abierta una conexion keep-alive. Solo los lee el motor; el contenedor
# los ajusta por entorno sin reconstruir la imagen.
MOTOR_WORKERS=16
MOTOR_KEEPALIVE_S=1
CORS_ORIGIN=http://localhost:5173
# En produccion es obligatoria: sin ella la API no arranca, para no firmar
# sesiones con el secreto de desarrollo que esta en el repositorio.
SESSION_SECRET=cambia-esto-por-un-secreto-fuerte
NODE_ENV=development
# Proxies delante de la API (CloudFront y ALB en produccion; 0 en local).
TRUST_PROXY_HOPS=0
# Cabecera secreta que inyecta CloudFront. Sin definir, no se exige (local).
ORIGIN_VERIFY=
# DEBUG_IP=1 registra la IP y X-Forwarded-For de cada intento de login, para
# calibrar TRUST_PROXY_HOPS. Solo eso: no registra usuario ni contraseña.
# Apagado por defecto; se enciende un momento y se vuelve a apagar.
DEBUG_IP=0

# Limite de peticiones (general y de login). Valores por defecto: 300 peticiones
# por ventana de 15 min en toda la API, y 20 intentos fallidos de login.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=20
# DESACTIVAR_LIMITES=1 apaga los dos limitadores para poder medir carga en local
# sin que un 429 corte la corrida. NUNCA aplica con NODE_ENV=production, aunque
# la variable venga puesta. Ver scripts/load-test.mjs.
DESACTIVAR_LIMITES=0

# Solo se usan si la coleccion de usuarios esta vacia al arrancar: crea el
# primer administrador para que exista una forma de entrar al sistema.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_NOMBRE=Administrador
