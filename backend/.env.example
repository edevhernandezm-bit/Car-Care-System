# Backend
PORT=5000
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@cluster.example.mongodb.net/car_care_system?retryWrites=true&w=majority
PROLOG_BASE=http://localhost:8000
PROLOG_TIMEOUT_MS=3000
# Token compartido con el motor: hexadecimal y el mismo valor en los dos. Si el
# motor arranca sin definirlo queda ABIERTO (acepta peticiones sin token) y lo
# avisa por stderr: es lo comodo para un despliegue por etapas, no para
# produccion.
MOTOR_TOKEN=decafbaddecafbad
CORS_ORIGIN=http://localhost:5173
# En produccion es obligatoria: sin ella la API no arranca, para no firmar
# sesiones con el secreto de desarrollo que esta en el repositorio.
SESSION_SECRET=cambia-esto-por-un-secreto-fuerte
NODE_ENV=development
# Proxies delante de la API (CloudFront y ALB en produccion; 0 en local).
TRUST_PROXY_HOPS=0
# Cabecera secreta que inyecta CloudFront. Sin definir, no se exige (local).
ORIGIN_VERIFY=
# DEBUG_IP=1 registra la IP y X-Forwarded-For de cada intento de login, para
# calibrar TRUST_PROXY_HOPS. Solo eso: no registra usuario ni contraseña.
# Apagado por defecto; se enciende un momento y se vuelve a apagar.
DEBUG_IP=0

# Solo se usan si la coleccion de usuarios esta vacia al arrancar: crea el
# primer administrador para que exista una forma de entrar al sistema.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_NOMBRE=Administrador
